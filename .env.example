# Copy to .env and fill in. Never commit .env - it is gitignored.

# --- Chat model ---------------------------------------------------------
# Provider-prefixed model string. Default: google-gla:gemini-3.5-flash
# Other examples:
#   google-gla:gemini-3.7-flash   (newest Flash; tuned for agentic/coding work)
#   openai:gpt-4.1-nano
# LLM_MODEL=google-gla:gemini-3.5-flash

# Required for Gemini models. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-key-here

# Required only if you use an OpenAI chat model, or the OpenAI embedding provider.
OPENAI_API_KEY=sk-your-key-here

# Embedding provider: "local" (default, free, offline) or "openai".
# OpenAI's text-embedding-3-small retrieves noticeably better on source code,
# at roughly $0.02 per million tokens. See the README.
EMBEDDING_PROVIDER=local

# Optional: override the model for whichever provider is selected.
# Local default:  multi-qa-distilbert-cos-v1
# OpenAI default: text-embedding-3-small
# EMBEDDING_MODEL=

# Optional: set to 0 to disable the on-disk embedding cache.
# The cache lives in ragbot/data/index/embeddings/ and makes re-indexing a repo
# near-instant. Each model gets its own namespace, so switching provider is safe.
# EMBEDDING_CACHE=1
