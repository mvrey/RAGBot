# Copy to backend/.env and fill in. Never commit .env - it is gitignored.

# --- Chat model ---------------------------------------------------------
# Provider-prefixed model string. Default: google-gla:gemini-3.5-flash
# Other examples:
#   google-gla:gemini-3.7-flash   (newest Flash; tuned for agentic/coding work)
#   openai:gpt-4.1-nano
# LLM_MODEL=google-gla:gemini-3.5-flash

# Required for Gemini models (chat and/or the default embedding provider).
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-key-here

# Required only if you use an OpenAI chat model, or the OpenAI embedding provider.
OPENAI_API_KEY=sk-your-key-here

# Embedding provider: "google" (default), "local" (free, fully offline, no API
# key - pulls in torch via `pip install '.[local-embeddings]'`), or "openai".
EMBEDDING_PROVIDER=google

# Optional: override the model for whichever provider is selected.
# Google default: gemini-embedding-2
# Local default:  multi-qa-distilbert-cos-v1
# OpenAI default: text-embedding-3-small
# EMBEDDING_MODEL=

# Optional: vector size for the Google provider (128-3072). Default 768.
# Changing this changes the embedding cache namespace, so old cached vectors
# for a different dimension are simply ignored rather than mixed in.
# EMBEDDING_DIMENSIONS=768

# Optional: set to 0 to disable the on-disk embedding cache.
# EMBEDDING_CACHE=1

# --- Storage -------------------------------------------------------------
# Where the repo mirror + embedding cache, and interaction logs, are written.
# Defaults are relative to the installed package (fine for local dev); a
# container should point these at a mounted volume.
# RAGBOT_DATA_DIR=/data
# RAGBOT_LOG_DIR=/logs

# --- CORS ------------------------------------------------------------------
# Comma-separated origins the frontend is served from.
CORS_ORIGINS=http://localhost:3000
